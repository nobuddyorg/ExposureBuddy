{
  "config": {
    // Prose wraps at whatever the author found readable; line length carries no meaning here.
    "MD013": false,
    // Bare URLs are fine in issue references and log excerpts.
    "MD034": false,
    // Inline HTML is occasionally the only way to get a layout right, and the README holds an HTML comment for the screenshot.
    "MD033": false
  },
  "globs": [
    "**/*.md",
    "!**/node_modules/**",
    "!web/out/**",
    "!web/.next/**",
    // Written by monocart after every e2e run; gitignored, so CI never sees it but a local `prek run --all-files` did.
    "!web/coverage-e2e/**",
    // Stryker's sandbox copies of the tree, left behind by an interrupted run.
    "!web/.stryker-tmp/**",
    // Playwright writes an error-context.md per failed test; gitignored output, not authored docs.
    "!web/test-results/**",
    "!web/playwright-report/**",
    // Written verbatim by `next dev`/`next build`, and a one-line `@AGENTS.md` import -- not authored docs.
    "!web/AGENTS.md",
    "!web/CLAUDE.md"
  ]
}
